[Unit]
Description=Spin the Bottle bot (FastAPI + aiogram)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/spinbot
EnvironmentFile=/opt/spinbot/.env
# one process only: the game state (tables, players) lives in memory; listens on localhost, nginx is the public side
ExecStart=/opt/spinbot/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010 --ws-ping-interval 15 --ws-ping-timeout 15
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
