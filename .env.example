# Get the token from @BotFather
BOT_TOKEN=
# Public HTTPS URL of this server (ngrok / cloudflared / your domain)
WEBAPP_URL=https://your-domain.example
# Optional: channel for the "subscribe" free-hearts task (bot must be admin there)
CHANNEL=@your_channel
# Optional: support account shown in Settings
SUPPORT=@your_support
PORT=8000
# Optional: Telegram ids that may use /broadcast <text> (comma separated)
ADMIN_IDS=
# Hour (server time) after which the daily-bonus reminder is sent
REMINDER_HOUR=10
